#, fuzzy
msgid "plugins.generic.staticEditorialTeam.displayName"
msgstr "Статичен редакционен екип"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.description"
msgstr "Възстановява статичната страница на редакционния екип от по-старите версии на OJS: страницата показва свободния текст от настройките на списанието вместо динамичния списък, изграден от потребителските роли."

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.fieldLabel"
