msgstr "Този текст се показва на страницата на редакционния екип в сайта вместо автоматичния списък с потребители. Опишете екипа с пълни имена, месторабота и, ако желаете, мандати."

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.description"
msgstr "Изберете как се изгражда страницата на редакционния екип за това списание. Статичното съдържание е свободният текст, зададен в настройките на списанието."

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.where.title"
