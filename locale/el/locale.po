#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.mode.staticOnly"
msgstr "Μόνο στατικό περιεχόμενο (συμπεριφορά παλαιότερων εκδόσεων)"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.mode.staticFirst"
msgstr "Στατικό περιεχόμενο, ακολουθούμενο από τη δυναμική λίστα χρηστών"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.mode.staticLast"
msgstr "Δυναμική λίστα χρηστών, ακολουθούμενη από το στατικό περιεχόμενο"

