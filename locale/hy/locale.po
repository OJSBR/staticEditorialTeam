#, fuzzy
msgid "plugins.generic.staticEditorialTeam.displayName"
msgstr "Ստատիկ խմբագրական կազմ"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.description"
msgstr "Վերականգնում է OJS-ի նախորդ տարբերակների ստատիկ խմբագրական կազմի էջը. էջը ցուցադրում է ամսագրի կարգավորումների ազատ տեքստը՝ օգտվողների դերերից կառուցվող դինամիկ ցանկի փոխարեն։"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.fieldLabel"
msgstr "Խմբագրական կազմ"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.fieldDescription"
msgstr "Այս տեքստը ցուցադրվում է կայքի խմբագրական կազմի էջում՝ օգտվողների ավտոմատ ցանկի փոխարեն։ Նկարագրեք խմբագրական կազմը լրիվ անուններով, կազմակերպություններով և, ցանկության դեպքում, պաշտոնավարման ժամկետներով։"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.description"
msgstr "Ընտրեք, թե ինչպես է կառուցվում խմբագրական կազմի էջն այս ամսագրի համար։ Ստատիկ բովանդակությունն ամսագրի կարգավորումներում սահմանված ազատ տեքստն է։"

