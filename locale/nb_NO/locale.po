#, fuzzy
msgid "plugins.generic.staticEditorialTeam.description"
msgstr "Gjenoppretter den statiske siden for redaksjonen fra tidligere OJS-versjoner: siden viser friteksten fra tidsskriftets innstillinger i stedet for den dynamiske listen som bygges fra brukerroller."

