#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.where.body"
msgstr "Besedilo na strani je polje z oblikovanim besedilom na zavihku Uredništvo v nastavitvah revije (v standardnem OJS 3.5 poimenovano »Uredniška zgodovina«)."

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.where.link"
msgstr "Odprite Nastavitve > Revija > Uredništvo"

