#, fuzzy
msgid "plugins.generic.staticEditorialTeam.displayName"
msgstr "Statično uredništvo"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.description"
msgstr "Obnovi statično stran uredništva iz prejšnjih različic OJS: stran prikaže prosto besedilo iz nastavitev revije namesto dinamičnega seznama, sestavljenega iz uporabniških vlog."

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.fieldLabel"
msgstr "Uredništvo"

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.fieldDescription"
msgstr "To besedilo se prikaže na strani uredništva na spletišču namesto samodejnega seznama uporabnikov. Uredništvo opišite s polnimi imeni, ustanovami in po želji z mandatnimi obdobji."

#, fuzzy
msgid "plugins.generic.staticEditorialTeam.settings.description"
